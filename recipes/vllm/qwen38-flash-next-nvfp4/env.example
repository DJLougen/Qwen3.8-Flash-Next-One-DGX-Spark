# vLLM · Qwen3.8-Flash-Next NVFP4 · one DGX Spark (GB10)
# Copy to .env and edit. Never commit real secrets.

VLLM_VENV=/opt/llm/runtime/vllm-venv-fnext
MODEL_DIR=/opt/llm/models/qwen38-flash-next-nvfp4

HOST=127.0.0.1
PORT=8092
SERVED_MODEL_NAME=flashnext

# 8192 is a BENCHMARK value. Real work needs 32768+ -- this model emitted
# 31,115 characters of reasoning before 12,931 of content on one code task,
# and a short window truncates mid-thought with no error.
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=4096
GPU_MEMORY_UTILIZATION=0.90

# MTP speculation. 0 disables. k=2 measured best here; k=5 hard-fails
# (QSA ring capacity must divide the attention block size).
SPEC_MTP_K=2

# Host-memory floor checked before launch, and required swap.
MIN_START_MEM_GIB=8
MIN_SWAP_GIB=48

# Required only when HOST is not loopback. Never commit the real value.
# API_KEY=
