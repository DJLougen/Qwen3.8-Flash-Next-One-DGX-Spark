# Example environment for recipe sglang/qwen38-flash-next-nvfp4-qsa-nextn (sglang)
# Copy these into your shell or a local env file before running. No secrets here.

# Path to the RadixArk/Qwen3.8-Flash-Next-NVFP4 snapshot (~126 GiB). Must contain
# the model-plefp8-*.safetensors shards: the PLE table is read from this
# directory at runtime rather than loaded into memory.
MODEL_PATH=/path/to/Qwen3.8-Flash-Next-NVFP4

# Local clone of the engine fork, mounted as a full-tree PYTHONPATH overlay over
# the container's own sglang:
#   git clone -b feat/qwen4-nvme-ple https://github.com/jzinno/sglang.git
#   git -C sglang checkout d4477bd298aef3edae611eb7b2e533d5526e324b
FORK_PATH=/path/to/jzinno-sglang

# Container engine and image. Podman requires CDI; see README.
CONTAINER_ENGINE=podman
IMAGE=docker.io/scitrera/dgx-spark-sglang:0.5.17

# Context length. 262144 is the full window and the tested configuration.
CTX=262144

# PLE table access mode: mmap (tested) or io_uring (faster, needs a relaxed
# seccomp profile under podman -- see README).
PLE_BACKEND=mmap

# Optional: relaxed seccomp profile, only needed for PLE_BACKEND=io_uring.
# SECCOMP_PROFILE=/path/to/seccomp-io-uring.json

HOST=127.0.0.1
PORT=30000
