+                for (int mask = 16; mask > 0; mask >>= 1) {
+                    ss += __shfl_xor_sync(0xffffffff, ss, mask);
+                }
+                const float scale = rsqrtf(ss / (float) ne00 + eps);
+                x0 *= scale * weight[i00 + 0];
+                x1 *= scale * weight[i00 + 1];
+                x2 *= scale * weight[i00 + 2];
+                x3 *= scale * weight[i00 + 3];
+            }
+            out[i00 + 0] = x0;
+            out[i00 + 1] = x1;
+            out[i00 + 2] = x2;
+            out[i00 + 3] = x3;
+        }
+    }
+}
