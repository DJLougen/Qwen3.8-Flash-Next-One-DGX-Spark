+template<typename src0_t>
+static __global__ void k_get_rows_mean_float(
+        const src0_t * src0, const int32_t * src1, float * dst,
+        const int64_t ne00, const int r,
+        const size_t nb01, const size_t nb02,
+        const size_t s10, const size_t s11,
+        const size_t s1, const size_t s2) {
+    ggml_cuda_pdl_lc();
+    ggml_cuda_pdl_sync();
+    const int b  = blockIdx.x;
+    const int i11 = blockIdx.y;
+    for (int64_t i00 = threadIdx.x; i00 < ne00; i00 += blockDim.x) {
+        float acc = 0.0f;
+        for (int j = 0; j < r; ++j) {
+            const int i01 = src1[(b * r + j) * s10 + i11 * s11];
+            const src0_t * row = (const src0_t *)((const char *) src0 + i01 * nb01 + i11 * nb02);
+            acc += ggml_cuda_cast<float>(row[i00]);
+        }
+        dst[b * s1 + i11 * s2 + i00] = acc / (float) r;
+    }
+}
+
+// QSA: r==4, ne00==128. One warp, 4-wide, indices in registers.
+template<typename src0_t>
+static __global__ void k_get_rows_mean_float4_r4(
+        const src0_t * src0, const int32_t * src1, float * dst,
+        const int64_t ne00,
+        const size_t nb01, const size_t nb02,
+        const size_t s10, const size_t s11,
+        const size_t s1, const size_t s2,
+        const float * weight, const float eps) {
+    ggml_cuda_pdl_lc();
+    ggml_cuda_pdl_sync();
+    const int b   = blockIdx.x;
+    const int i11 = blockIdx.y;
+    const int i0  = src1[(b * 4 + 0) * s10 + i11 * s11];
+    const int i1  = src1[(b * 4 + 1) * s10 + i11 * s11];
+    const int i2  = src1[(b * 4 + 2) * s10 + i11 * s11];
+    const int i3  = src1[(b * 4 + 3) * s10 + i11 * s11];
+    const src0_t * row0 = (const src0_t *)((const char *) src0 + i0 * nb01 + i11 * nb02);
+    const src0_t * row1 = (const src0_t *)((const char *) src0 + i1 * nb01 + i11 * nb02);
+    const src0_t * row2 = (const src0_t *)((const char *) src0 + i2 * nb01 + i11 * nb02);
+    const src0_t * row3 = (const src0_t *)((const char *) src0 + i3 * nb01 + i11 * nb02);
+    float * out = dst + b * s1 + i11 * s2;
+    for (int64_t i00 = threadIdx.x * 4; i00 < ne00; i00 += blockDim.x * 4) {
+        if constexpr (std::is_same<src0_t, half>::value) {
+            const half2 a0 = __ldg((const half2 *)(row0 + i00));
+            const half2 a1 = __ldg((const half2 *)(row0 + i00 + 2));
+            const half2 b0 = __ldg((const half2 *)(row1 + i00));
+            const half2 b1 = __ldg((const half2 *)(row1 + i00 + 2));
+            const half2 c0 = __ldg((const half2 *)(row2 + i00));
+            const half2 c1 = __ldg((const half2 *)(row2 + i00 + 2));
+            const half2 d0 = __ldg((const half2 *)(row3 + i00));
+            const half2 d1 = __ldg((const half2 *)(row3 + i00 + 2));
+            const float2 fa0 = __half22float2(a0), fa1 = __half22float2(a1);
+            const float2 fb0 = __half22float2(b0), fb1 = __half22float2(b1);
+            const float2 fc0 = __half22float2(c0), fc1 = __half22float2(c1);
+            const float2 fd0 = __half22float2(d0), fd1 = __half22float2(d1);
+            float x0 = 0.25f * (fa0.x + fb0.x + fc0.x + fd0.x);
+            float x1 = 0.25f * (fa0.y + fb0.y + fc0.y + fd0.y);
+            float x2 = 0.25f * (fa1.x + fb1.x + fc1.x + fd1.x);
+            float x3 = 0.25f * (fa1.y + fb1.y + fc1.y + fd1.y);
+            if (weight) {
+                float ss = x0*x0 + x1*x1 + x2*x2 + x3*x3;
+#pragma unroll
+                for (int mask = 16; mask > 0; mask >>= 1) {
+                    ss += __shfl_xor_sync(0xffffffff, ss, mask);
+                }
+                const float scale = rsqrtf(ss / (float) ne00 + eps);
+                x0 *= scale * weight[i00 + 0];
+                x1 *= scale * weight[i00 + 1];
+                x2 *= scale * weight[i00 + 2];
+                x3 *= scale * weight[i00 + 3];
+            }
+            out[i00 + 0] = x0;
+            out[i00 + 1] = x1;
+            out[i00 + 2] = x2;
+            out[i00 + 3] = x3;
+        } else {
+            const float4 v0 = __ldg((const float4 *)(row0 + i00));
+            const float4 v1 = __ldg((const float4 *)(row1 + i00));
+            const float4 v2 = __ldg((const float4 *)(row2 + i00));
+            const float4 v3 = __ldg((const float4 *)(row3 + i00));
+            float x0 = 0.25f * (v0.x + v1.x + v2.x + v3.x);
+            float x1 = 0.25f * (v0.y + v1.y + v2.y + v3.y);
+            float x2 = 0.25f * (v0.z + v1.z + v2.z + v3.z);
+            float x3 = 0.25f * (v0.w + v1.w + v2.w + v3.w);
+            if (weight) {
+                float ss = x0*x0 + x1*x1 + x2*x2 + x3*x3;
