diff --git a/ggml/src/ggml.c b/ggml/src/ggml.c
index e0b615c07..3607246ef 100644
--- a/ggml/src/ggml.c
+++ b/ggml/src/ggml.c
@@ -3911,6 +3911,37 @@ struct ggml_tensor * ggml_get_rows(
     return result;
 }
 
+struct ggml_tensor * ggml_get_rows_mean(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b,
+        int                   r,
+        struct ggml_tensor  * w,
+        float                 eps) {
+    GGML_ASSERT(r > 1);
+    GGML_ASSERT(b->ne[0] % r == 0);
+    GGML_ASSERT(a->ne[2] == b->ne[1]);
+    GGML_ASSERT(a->ne[3] == b->ne[2]);
+    GGML_ASSERT(b->ne[3] == 1);
+    GGML_ASSERT(b->type == GGML_TYPE_I32);
+    if (w) {
+        GGML_ASSERT(w->type == GGML_TYPE_F32);
+        GGML_ASSERT(w->ne[0] == a->ne[0]);
+        GGML_ASSERT(eps >= 0.0f);
+    }
+
+    struct ggml_tensor * result = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, a->ne[0], b->ne[0] / r, b->ne[1], b->ne[2]);
+
+    result->op     = GGML_OP_GET_ROWS;
+    result->src[0] = a;
+    result->src[1] = b;
+    result->src[2] = w;
+    ggml_set_op_params_i32(result, 0, r);
+    ggml_set_op_params_f32(result, 1, eps);
+
+    return result;
+}
+
 // ggml_get_rows_back
 
